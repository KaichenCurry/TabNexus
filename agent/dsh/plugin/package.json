{
  "name": "dsh-plugin-tabnexus",
  "version": "0.1.0",
  "description": "TabNexus for DSH：把浏览器里散落的任务上下文，变成 Harness 可直接调用的插件化记忆。提供 17 个 mcp__tabnexus__* 工具与连接状态面板。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./client": { "types": "./lib/types/client/index.d.ts", "default": "./lib/client.js" },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml", "README.md"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "inject": ["@deepseek-ai/dsh-client-runtime"], "platform": "web" }
  },
  "keywords": ["dsh-plugin", "tabnexus", "browser", "tabs", "mcp", "deepseek-harness"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/KaichenCurry/TabNexus.git",
    "directory": "agent/dsh/plugin"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-mcp-client": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "lightningcss": "^1.29.0",
    "tsdown": "0.22.0",
    "typescript": "7.0.2"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.client.json && tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit"
  }
}
